{
  "name": "materials-ui",
  "version": "0.2.7",
  "private": true,
  "description": "The browser half of the materials module, on the component library, built into the bundle the host serves.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check": "pnpm run lint && pnpm run format:check && pnpm run check:svelte && pnpm run test",
    "test": "vitest run"
  },
  "dependencies": {
    "@lucide/svelte": "1.58.0",
    "@prusa/connect": "0.0.1",
    "@prusa/connect-ui": "0.0.1",
    "materials-client": "link:../client"
  },
  "devDependencies": {
    "@prusa/frontend-standards": "0.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.10.0",
    "playwright": "1.64.1",
    "prettier": "3.9.6",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.4",
    "vitest": "5.0.5",
    "vitest-browser-svelte": "3.1.0"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
